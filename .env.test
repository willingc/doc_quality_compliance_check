# Pytest-local environment overlay (applied by tests/conftest.py before importing the app).
# Safe to commit: no secrets. Overrides root `.env` for the Python process running pytest only.
APP_NAME="Doc Quality Compliance Check"

ENVIRONMENT=development
DEBUG=false

# Matches tests that use X-API-Key headers (same value as historical conftest default).
SECRET_KEY=test-api-key

SESSION_TTL_SHORT_MINUTES=120
SESSION_TTL_REMEMBER_ME_MINUTES=7200

# Valid MVP credentials so TestClient fixtures can log in (password ≥12 chars).
AUTH_MVP_EMAIL=test-mvp@example.invalid
AUTH_MVP_PASSWORD=test-mvp-password-12
AUTH_MVP_ROLES=qm_lead
AUTH_MVP_ORG=QM-TEST

# Keep API startup/import from requiring Postgres; tests attach an in-memory DB via overrides.
DATABASE_URL=sqlite:///:memory:
DATABASE_ECHO=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

LOG_LEVEL=INFO
LOG_FORMAT=console

METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_EXPORTER=none
TRACING_OTLP_ENDPOINT=
TRACING_SAMPLING_RATIO=1.0
TELEMETRY_SERVICE_NAME=doc-quality-api-pytest

MAX_FILE_SIZE_MB=50
